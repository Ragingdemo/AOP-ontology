{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "cd src/ontology && sh run.sh make prepare_release VERSION=${nextRelease.version}"
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "aopo.owl", "aopo.obo", "aopo.json", "aopo-base.owl", "aopo-base.obo", "aopo-base.json", "aopo-full.owl", "aopo-full.obo", "aopo-full.json", "aopo-simple.owl", "aopo-simple.obo", "aopo-simple.json"],
      "message": "chore(release): ${nextRelease.version} [skip ci]"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "aopo.owl" }, { "path": "aopo.obo" }, { "path": "aopo.json" },
        { "path": "aopo-base.owl" }, { "path": "aopo-full.owl" }
      ]
    }]
  ]
}
