        <obo:IAO_0000115>A key event of regulatory significance, at the individual or population level, that constitutes the terminal adverse endpoint of an adverse outcome pathway.</obo:IAO_0000115>
        <rdfs:label>adverse_outcome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000062 -->

