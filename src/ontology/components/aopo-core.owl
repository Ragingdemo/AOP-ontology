            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that represents the causal sequence of key events linking a molecular initiating event to an adverse outcome, together with the evidence assessment of the linkage, as curated in an AOP knowledge base such as the AOP-Wiki.</obo:IAO_0000115>
        <rdfs:label>adverse_outcome_pathway</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A biological process representing a measurable change in biological state that is essential to the progression of an adverse outcome pathway.</obo:IAO_0000115>
        <rdfs:label>key_event</rdfs:label>
    </owl:Class>
    


