            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity asserting a scientifically supported, directional causal linkage between an upstream key event and a downstream key event, together with the weight of evidence for that linkage.</obo:IAO_0000115>
        <rdfs:label>key_event_relationship</rdfs:label>
    </owl:Class>
    


