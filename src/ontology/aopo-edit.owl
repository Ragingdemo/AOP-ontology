    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/aopo/value/asexual">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000241"/>
        <rdfs:label>Asexual</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/aopo/value/biosphere -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/aopo/value/biosphere">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000238"/>
        <rdfs:label>Biosphere</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/aopo/value/by_sa -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/aopo/value/by_sa">
