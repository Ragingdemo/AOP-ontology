<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/aopo/aopo-edit.owl#"
     xml:base="http://purl.obolibrary.org/obo/aopo/aopo-edit.owl"
     xmlns:CL="http://purl.obolibrary.org/obo/CL_"
     xmlns:GO="http://purl.obolibrary.org/obo/GO_"
     xmlns:RO="http://purl.obolibrary.org/obo/RO_"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:BFO="http://purl.obolibrary.org/obo/BFO_"
     xmlns:IAO="http://purl.obolibrary.org/obo/IAO_"
     xmlns:OBI="http://purl.obolibrary.org/obo/OBI_"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:AOPO="http://purl.obolibrary.org/obo/AOPO_"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:CHEBI="http://purl.obolibrary.org/obo/CHEBI_"
     xmlns:AOPO_v="http://purl.obolibrary.org/obo/aopo/value/"
     xmlns:UBERON="http://purl.obolibrary.org/obo/UBERON_"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:NCBITaxon="http://purl.obolibrary.org/obo/NCBITaxon_">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/aopo/aopo-edit.owl">
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/aopo/aopo-core.owl"/>
        <dc:title>AOPO AOP-Wiki module</dc:title>
        <rdfs:comment>Pluggable AOP-Wiki extension of AOP-Core.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasExactSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100021 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100021">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000224"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A relation between a stressor and a chemical that the stressor record is about.</obo:IAO_0000115>
        <rdfs:comment>Specialised to IAO denotes: the stressor record denotes a particular chemical.</rdfs:comment>
        <rdfs:label>has_chemical_entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100027 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100027">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000089"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000231"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000232"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000245"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000235"/>
        <obo:IAO_0000115>A relation between an assessed item (a key event relationship assessment, a stressor association or an applicability statement) and its evidence level.</obo:IAO_0000115>
        <rdfs:label>has_evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100056 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100056">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000142"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000062"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000224"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway and a stressor documented to initiate it.</obo:IAO_0000115>
        <rdfs:comment>Specialised to IAO mentions: the AOP references but is not primarily about the stressor record.</rdfs:comment>
        <rdfs:label>has_stressor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100057 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100057">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000062"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000233"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway and its overall assessment.</obo:IAO_0000115>
        <rdfs:label>has_overall_assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100058 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100058">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000062"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000239"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway and its OECD status.</obo:IAO_0000115>
        <rdfs:label>has_oecd_status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100059 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100059">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000062"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000240"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway and the licence under which the AOP-Wiki publishes it.</obo:IAO_0000115>
        <rdfs:label>has_wiki_license</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100060 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100060">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000062"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000234"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway and an external link recorded for it.</obo:IAO_0000115>
        <rdfs:label>has_external_link</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100061 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100061">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000105"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000106"/>
        <obo:IAO_0000115>A relation between a key event and a biological event that the key event describes.</obo:IAO_0000115>
        <rdfs:comment>KE (process) to its component descriptor (ICE); inverse of an is-about, so not a has_part.</rdfs:comment>
        <rdfs:label>has_biological_event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100062 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100062">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000106"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000226"/>
        <obo:IAO_0000115>A relation between a biological event and the biological process that changes in it.</obo:IAO_0000115>
        <rdfs:label>has_process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100063 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100063">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000106"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000227"/>
        <obo:IAO_0000115>A relation between a biological event and the biological object that changes in it.</obo:IAO_0000115>
        <rdfs:comment>Descriptor-level reference (the component is about the object term). The reality-layer relation is has_object_participant (RO:0000057) on the key-event process.</rdfs:comment>
        <rdfs:label>has_object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100064 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100064">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000106"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000229"/>
        <obo:IAO_0000115>A relation between a biological event and the biological action that specifies the direction or kind of change it represents.</obo:IAO_0000115>
        <rdfs:comment>Records the direction/kind of change; not aboutness. Reality-layer counterpart: RO:0002304 / RO:0002305 (causally upstream of, positive/negative effect) on the KER, or a PATO quality of the key-event process.</rdfs:comment>
        <rdfs:label>has_action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100065 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100065">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000105"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000238"/>
        <obo:IAO_0000115>A relation between a key event and the biological organisation level at which it is measured.</obo:IAO_0000115>
        <rdfs:comment>KE (process) to the organisation level at which it is measured; metadata, left unrefined.</rdfs:comment>
        <rdfs:label>has_biological_organization_level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100066 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100066">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000066"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000105"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000243"/>
        <obo:IAO_0000115>A relation between a key event and the cell type in which the described change occurs.</obo:IAO_0000115>
        <rdfs:label>has_cell_term</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100067 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100067">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000066"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000105"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000244"/>
        <obo:IAO_0000115>A relation between a key event and the organ or tissue in which the described change occurs.</obo:IAO_0000115>
        <rdfs:label>has_organ_term</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100068 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100068">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000062"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000105"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000107"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000231"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway, key event or key event relationship and an applicability statement about it.</obo:IAO_0000115>
        <rdfs:comment>Subject is described by the applicability statement (inverse of is-about); mixed ICE/process domain, left unrefined.</rdfs:comment>
        <rdfs:label>has_applicability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100069 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100069">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000062"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000245"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway and an assessment of one of its key event relationships.</obo:IAO_0000115>
        <rdfs:label>has_key_event_relationship_assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100070 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100070">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000245"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000237"/>
        <obo:IAO_0000115>A relation between a key event relationship assessment and the adjacency value it records.</obo:IAO_0000115>
        <rdfs:label>has_adjacency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100071 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100071">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000245"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000236"/>
        <obo:IAO_0000115>A relation between a key event relationship assessment and the quantitative understanding level it records.</obo:IAO_0000115>
        <rdfs:label>has_quantitative_understanding_level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100072 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100072">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000107"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000089"/>
        <obo:IAO_0000115>A relation between a key event relationship and its weight-of-evidence assessment.</obo:IAO_0000115>
        <rdfs:label>has_weight_of_evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100073 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100073">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000107"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000129"/>
        <obo:IAO_0000115>A relation between a key event relationship and its quantitative-understanding assessment.</obo:IAO_0000115>
        <rdfs:label>has_quantitative_understanding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100074 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100074">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000062"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000105"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000232"/>
        <obo:IAO_0000115>A relation between an adverse outcome pathway or key event and a stressor association that records one of its stressors with evidence.</obo:IAO_0000115>
        <rdfs:comment>Subject is recorded by the stressor association; mixed ICE/process domain, left unrefined.</rdfs:comment>
        <rdfs:label>has_stressor_association</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100075 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100075">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000231"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000230"/>
        <rdfs:comment>NEW ID. Reality layer: in taxon (RO:0002162).</rdfs:comment>
        <rdfs:label>applies_to_taxon</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100076 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100076">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000231"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000241"/>
        <rdfs:comment>NEW ID.</rdfs:comment>
        <rdfs:label>applies_to_sex</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100077 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100077">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000231"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000242"/>
        <rdfs:comment>NEW ID.</rdfs:comment>
        <rdfs:label>applies_to_life_stage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100078 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100078">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000245"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000107"/>
        <rdfs:comment>NEW ID.</rdfs:comment>
        <rdfs:label>assesses_key_event_relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100079 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100079">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000232"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000224"/>
        <rdfs:comment>NEW ID.</rdfs:comment>
        <rdfs:label>associates_stressor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0100080 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AOPO_0100080">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000105"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000227"/>
        <obo:IAO_0000115>A relation between a key event and the biological object that participates in the change it represents.</obo:IAO_0000115>
        <rdfs:comment>Reality-layer complement to has_object: the key-event process has the biological object as a participant.</rdfs:comment>
        <rdfs:label>has_object_participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000066 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000066">
