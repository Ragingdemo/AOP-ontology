    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000105 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000105">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100061"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000106"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100065"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000238"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100066"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000243"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100067"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100068"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100080"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000227"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000226"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100063"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000227"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100064"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000229"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that describes a key event as a (biological process, object, action) triple whose parts are terms drawn from domain ontologies (GO, CL, UBERON, ChEBI, PR). In the AOP-Wiki schema this is the biological-event.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>biological event</oboInOwl:hasExactSynonym>
        <rdfs:label>key_event_component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000107 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/AOPO_0000107">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100068"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100072"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000089"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100073"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000129"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity that holds the quantitative-understanding assessment of a key event relationship: its description, supporting evidence, response-response relationship, time scale and feedforward or feedback loops.</obo:IAO_0000115>
        <rdfs:label>quantitative_understanding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100021"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that describes an agent, typically a chemical or a defined mixture, documented to initiate one or more adverse outcome pathways through a molecular initiating event.</obo:IAO_0000115>
        <rdfs:label>stressor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000226">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115>A biological process.</obo:IAO_0000115>
        <rdfs:label>biological_process</rdfs:label>
        <rdfs:comment>AOPO's local alias for the Gene Ontology biological process root: it denotes exactly the same processes. It exists so that the key-event-component process slot has an AOPO-namespace range rather than hard-coding GO. Any GO biological process is a biological_process and vice versa.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115>A material entity (protein, chemical entity, cell, anatomical structure, cellular component or population) that a key event component references as the entity that changes in the key event.</obo:IAO_0000115>
        <rdfs:label>biological_object</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the direction or kind of change (for example increased, decreased, occurrence, disrupted, functional change) that a biological event represents in its object or process.</obo:IAO_0000115>
        <rdfs:label>biological_action</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000230">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_1"/>
        <obo:IAO_0000115>An organism.</obo:IAO_0000115>
        <rdfs:label>taxonomy</rdfs:label>
        <rdfs:comment>AOPO's local alias for the NCBITaxon organism root: it denotes exactly the same organisms. Used as the range of applies_to_taxon. It is not restricted to taxa that an AOP has been declared applicable to — that restriction lives on the applicability statement, not on this class.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100027"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100075"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100076"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000241"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100077"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000242"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that records that an adverse outcome pathway, key event or key event relationship applies to a taxon, a sex or a life stage, together with the evidence level for that applicability.</obo:IAO_0000115>
        <rdfs:label>applicability_statement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100027"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100079"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that records that a stressor is documented to initiate an adverse outcome pathway or to trigger a key event, together with the evidence level for that association.</obo:IAO_0000115>
        <rdfs:label>stressor_association</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity that holds the overall assessment of an adverse outcome pathway: its description, domain of applicability, key event essentiality summary, weight-of-evidence summary, known modulating factors and quantitative considerations.</obo:IAO_0000115>
        <rdfs:label>overall_assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>An information content entity that records a web resource outside the AOP knowledge base that an adverse outcome pathway entry links to, with its URL, title and source.</obo:IAO_0000115>
        <rdfs:label>external_link</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the strength of the weight of evidence assigned by AOP developers to a key event relationship, a stressor association or an applicability statement (high, moderate, low, not specified).</obo:IAO_0000115>
        <rdfs:label>evidence_level</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the degree to which the quantitative relationship between an upstream and a downstream key event is understood (high, moderate, low, not specified).</obo:IAO_0000115>
        <rdfs:label>quantitative_understanding_level</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies whether a key event relationship links two key events that are directly adjacent in an adverse outcome pathway or are separated by intermediate key events.</obo:IAO_0000115>
        <rdfs:label>adjacency</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the level of biological organisation at which a key event is measured (molecular, cellular, tissue, organ, individual, population).</obo:IAO_0000115>
        <rdfs:label>biological_organization_level</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the stage of an adverse outcome pathway in the OECD AOP development programme review process (under development, under review, WPHA/WNT endorsed).</obo:IAO_0000115>
        <rdfs:label>oecd_status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the licence under which the AOP-Wiki publishes an adverse outcome pathway (all rights reserved, BY-SA, open for adoption).</obo:IAO_0000115>
        <rdfs:label>wiki_license</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the sex or sexes to which an adverse outcome pathway, key event or key event relationship applies.</obo:IAO_0000115>
        <rdfs:label>sex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115>A categorical value specification that specifies the life stage or developmental period to which an adverse outcome pathway, key event or key event relationship applies.</obo:IAO_0000115>
        <rdfs:label>life_stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000243">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CL_0000000"/>
        <obo:IAO_0000115>A cell.</obo:IAO_0000115>
        <rdfs:label>cell_term</rdfs:label>
        <rdfs:comment>AOPO's local alias for the Cell Ontology cell root: it denotes exactly the same cells. Used as the range of the key-event cell slot. It is not restricted to cells in which a key event occurs — that restriction lives on the key event, not on this class.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000244">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <obo:IAO_0000115>An anatomical entity.</obo:IAO_0000115>
        <rdfs:label>organ_term</rdfs:label>
        <rdfs:comment>AOPO's local alias for the UBERON anatomical entity root: it denotes exactly the same entities. Used as the range of the key-event organ slot. It is not restricted to organs or tissues in which a key event occurs — that restriction lives on the key event, not on this class.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/AOPO_0000245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AOPO_0000245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100027"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100070"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000237"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100071"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000236"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/AOPO_0100078"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/AOPO_0000107"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that records, for one key event relationship as used in one adverse outcome pathway, its adjacency, its evidence level and its quantitative understanding level.</obo:IAO_0000115>
        <rdfs:label>key_event_relationship_assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:label>chemical entity (ChEBI root)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:label>cell (CL root)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0008150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label>biological process (GO root)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCBITaxon_1 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_1">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:label>organism (NCBITaxon root)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001930 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:label>categorical value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label>value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:label>anatomical entity (UBERON root)</rdfs:label>
    </owl:Class>
    


