# An AOPO class must not be asserted owl:equivalentClass to the root of an imported
# ontology, EXCEPT for the four terms declared as deliberate local aliases below.
# Equivalence to a root makes the AOPO class interchangeable with that root, so every
# anatomical entity becomes an organ_term. For the four aliases that is the intent and
# their definitions say so; anywhere else it is a modelling error, usually a Protege
# "Equivalent To" entry that was meant to be "SubClass Of".
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?aopo_class ?root WHERE {
  VALUES ?root {
    <http://purl.obolibrary.org/obo/NCBITaxon_1>
    <http://purl.obolibrary.org/obo/CL_0000000>
    <http://purl.obolibrary.org/obo/UBERON_0001062>
    <http://purl.obolibrary.org/obo/CHEBI_24431>
    <http://purl.obolibrary.org/obo/GO_0008150>
    <http://purl.obolibrary.org/obo/BFO_0000015>
    <http://purl.obolibrary.org/obo/BFO_0000040>
    <http://purl.obolibrary.org/obo/IAO_0000030>
  }
  { ?aopo_class owl:equivalentClass ?root } UNION { ?root owl:equivalentClass ?aopo_class }
  FILTER(STRSTARTS(STR(?aopo_class), "http://purl.obolibrary.org/obo/AOPO_"))
  # Declared aliases: biological_process, taxonomy, cell_term, organ_term.
  FILTER(?aopo_class NOT IN (
    <http://purl.obolibrary.org/obo/AOPO_0000226>,
    <http://purl.obolibrary.org/obo/AOPO_0000230>,
    <http://purl.obolibrary.org/obo/AOPO_0000243>,
    <http://purl.obolibrary.org/obo/AOPO_0000244>
  ))
}
